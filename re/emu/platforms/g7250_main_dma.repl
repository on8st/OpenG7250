// g7250_main_dma.repl — generic DMA1/DMA2 (models/csharp/G7250Dma.cs,
// docs/DMA-model.md) in place of Renode 1.17's STM32DMA.
//
// Load procedure (the runners do this): compile the C# first
//   i @models/csharp/G7250Dma.cs
// then, after the base platform has registered dma1/dma2,
//   sysbus Unregister sysbus.dma1
//   sysbus Unregister sysbus.dma2
//   machine LoadPlatformDescription @platforms/g7250_main_dma.repl
// The interrupt lines are those of the base platform (RM0468 vector table);
// the dmamux1 entry re-wires its 16 outputs to the new streams.
dma1: DMA.G7250Dma @ sysbus <0x40020000, +0x400>
    controllerName: "DMA1"
    [0-7] -> nvic@[11-17, 47]

dma2: DMA.G7250Dma @ sysbus <0x40020400, +0x400>
    controllerName: "DMA2"
    [0-7] -> nvic@[56-60, 68-70]

dmamux1:
    [0-7] -> dma1@[0-7]
    [8-15] -> dma2@[0-7]
