// g7250_main_pa_plant.repl — PA bias DAC and PA plant on SPI2
// (docs/PA-plant-model.md).
//
// models/csharp/G7250PaPlant.cs decodes the bias DAC words (BU2506FV type on
// SPI2, LD = PB12, RESET = PB14; his/85-rf-control.md) and drives the ADC1
// input voltages (Idd, supply, PA NTC) on the generic ADC model.
// Load after `i @models/csharp/G7250PaPlant.cs` and after g7250_main_adc.repl;
// then `sysbus.spi2.pa Publish` sets the initial analog values.
pa: Antmicro.Renode.Peripherals.SPI.G7250PaPlant @ spi2

gpioPortB:
    12 -> pa@0
    14 -> pa@1
